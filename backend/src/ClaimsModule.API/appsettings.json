{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*",
  "_comment_ConnectionStrings": "Real values live in appsettings.Local.json (gitignored). See appsettings.Local.json.example for the template.",
  "ConnectionStrings": {
    "ClaimsDb": "",
    "Hangfire": ""
  },
  "Hangfire": {
    "Dashboard": {
      "AllowedRoles": [ "Supervisor", "Manager" ],
      "AllowLocalRequests": true
    }
  },
  "Storage": {
    "Provider": "LocalFileSystem",
    "AzureConnectionString": "",
    "LocalRootPath": "App_Data/uploads",
    "ContainerName": "claim-documents",
    "PublicBaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  }
}
